# Persistent application records. The directory is created with private mode.
PETLIBRO_MANAGEMENT_DATA_DIR=.data
PETLIBRO_RUNTIME_DATA_DIR=.runtime-data

# Private native capability-worker transport. The worker creates this socket with mode 0600.
PETLIBRO_CAPABILITY_WORKER_SOCKET=.data/worker.sock

# Read-only State Agent inspection configuration. Never commit the real token.
PETLIBRO_STATE_AGENT_URL=http://FEEDER_IP:8765
PETLIBRO_STATE_AGENT_TOKEN=replace-with-protected-token
PETLIBRO_STATE_AGENT_TIMEOUT_SECONDS=5

# Optional package/runtime identity returned by the management status endpoint.
PETLIBRO_MANAGEMENT_VERSION=0.1.0-development
