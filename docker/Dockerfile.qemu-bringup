FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

ENV DEBIAN_FRONTEND=noninteractive

# On hosts supplying a root-only Docker resolver, pass --secret
# id=resolver,src=/etc/resolv.conf. Keep APT's _apt sandbox enabled.
RUN --mount=type=secret,id=resolver,target=/etc/resolv.conf,mode=0444 \
    apt-get update && apt-get install -y --no-install-recommends \
    bc bison flex rsync unzip wget \
    build-essential \
    ca-certificates \
    cpio \
    curl \
    device-tree-compiler \
    file \
    git \
    iproute2 \
    iputils-ping \
    libfdt-dev \
    libglib2.0-dev \
    libpixman-1-dev \
    libslirp-dev \
    meson \
    ninja-build \
    openssh-client \
    pkg-config \
    procps \
    python3 \
    python3-venv \
    squashfs-tools \
    u-boot-tools \
    xz-utils \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
