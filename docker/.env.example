MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=petlibro_local_backend

# Keep disabled unless intentionally replacing the broker address stored by the
# physical feeder. This is separate from MQTT_HOST above.
PERSIST_FEEDER_MQTT=0
FEEDER_MQTT_HOST=
FEEDER_MQTT_PORT=1883
FEEDER_HTTPS_ADDR=

# Feeder State Agent snapshot/update API. Leave the URL empty to use
# http://<discovered-feeder-ip>:8765. The token must match the feeder agent.
PETLIBRO_STATE_AGENT_URL=
PETLIBRO_STATE_AGENT_TOKEN=
PETLIBRO_STATE_AGENT_TIMEOUT_SECONDS=2
STATE_AGENT_UPDATES_JSON={"enabled":false,"manifest_url":"","check_on_connect":true,"check_interval_hours":24}

# Limit Go compiler concurrency during local image builds.
GO_BUILD_PROCS=2

DEVICE_DISCOVERY=1
PRODUCT_FILTER=PLAF203
LAN_CIDR=192.168.1.0/24
IP_RESOLVE_TIMEOUT_SECONDS=15
IP_DISCOVERY_BROADCAST_SECONDS=2
IP_DISCOVERY_MAX_UNICAST_PER_SECOND=32
IP_REFRESH_INTERVAL_MINUTES=360
IP_RETRY_BACKOFF_SECONDS=60
DEVICES_JSON=[]

GO2RTC_STREAM_NAME=petlibro_feeder
CAMERA_QUALITY=hd
SEND_DELAY_CTRL=1
HD_PROBE_WAIT_MS=15000

GO2RTC_API_PORT=1984
GO2RTC_RTSP_PORT=8554
GO2RTC_WEBRTC_PORT=8555

PUBLISH_CAMERA_METADATA=1
CAMERA_METADATA_TOPIC_PREFIX=
CAMERA_METADATA_INTERVAL_SECONDS=30

# Petlibro application logs: critical, error, warning, info, debug, or trace.
LOG_LEVEL=info
# Legacy compatibility only. Used as debug when LOG_LEVEL is absent.
VERBOSE_LOGS=0
ENABLE_DEBUG_DUMPS=0
