CC ?= gcc
CFLAGS ?= -Os -Wall -Wextra -Werror -std=c99
CPPFLAGS ?=
CPPFLAGS += -D_GNU_SOURCE
LDFLAGS ?=

BINARY ?= plaf203-state-agent
UPDATE_HELPER ?= plaf203-update-fs
BUILD_DIR ?= build
VERSION_FILE ?= VERSION
PUBLIC_KEY_HEX_FILE ?= release-public-key.hex

SOURCES := \
	plaf203_state_agent.c \
	vendor/monocypher/monocypher.c \
	vendor/monocypher/monocypher-ed25519.c

UPDATE_HELPER_SOURCE := plaf203_update_fs.c

GENERATED_HEADER := $(BUILD_DIR)/generated_release_metadata.h
MANAGED_ASSETS_HEADER := $(BUILD_DIR)/generated_managed_assets.h
MANAGED_ASSETS := managed/ping managed/app_start.sh managed/app_start.legacy.sh

SEMVER_RE := ^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-([0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*))?(\\+([0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*))?$$

all: $(BINARY) $(UPDATE_HELPER)

$(BUILD_DIR):
	mkdir -p "$@"

$(GENERATED_HEADER): $(VERSION_FILE) $(PUBLIC_KEY_HEX_FILE) | $(BUILD_DIR)
	@set -eu; \
	version="$$(tr -d '\015\012' < "$(VERSION_FILE)")"; \
	if ! printf '%s' "$$version" | grep -Eq "$(SEMVER_RE)"; then \
		echo "Invalid strict SemVer in $(VERSION_FILE): '$$version'" >&2; \
		exit 1; \
	fi; \
	case "$$version" in \
		*-*) prerelease="$${version#*-}"; prerelease="$${prerelease%%+*}"; \
			for identifier in $$(printf '%s' "$$prerelease" | tr '.' ' '); do \
				if printf '%s' "$$identifier" | grep -Eq '^[0-9]+$$' && \
				   [ "$${#identifier}" -gt 1 ] && [ "$${identifier#0}" != "$$identifier" ]; then \
					echo "Invalid numeric SemVer prerelease identifier in $(VERSION_FILE): '$$identifier'" >&2; \
					exit 1; \
				fi; \
			done ;; \
	esac; \
	key_hex="$$(cat "$(PUBLIC_KEY_HEX_FILE)")"; \
	if [ "$${#key_hex}" -ne 64 ] || ! printf '%s' "$$key_hex" | grep -Eq '^[0-9a-fA-F]{64}$$'; then \
		echo "Invalid Ed25519 public key in $(PUBLIC_KEY_HEX_FILE); require exactly 64 hex chars" >&2; \
		exit 1; \
	fi; \
	upper_key="$$(printf '%s' "$$key_hex" | tr '[:lower:]' '[:upper:]')"; \
	{ \
		echo '/* Generated by Makefile; do not edit. */'; \
		echo '#ifndef PLAF203_GENERATED_RELEASE_METADATA_H'; \
		echo '#define PLAF203_GENERATED_RELEASE_METADATA_H'; \
		echo ''; \
		echo '#include <stdint.h>'; \
		echo ''; \
		echo '#define RELEASE_PUBLIC_KEY_EMBEDDED 1'; \
		printf '#define AGENT_VERSION "%s"\n' "$$version"; \
		echo 'static const uint8_t RELEASE_PUBLIC_KEY[32] = {'; \
		for i in $$(seq 0 31); do \
			offset=$$((i * 2)); \
			start=$$((offset + 1)); \
			end=$$((offset + 2)); \
			byte="$$(printf '%s' "$$upper_key" | cut -c $$start-$$end)"; \
			if [ $$i -lt 31 ]; then \
				printf '    0x%s,\n' "$$byte"; \
			else \
				printf '    0x%s\n' "$$byte"; \
			fi; \
		done; \
		echo '};'; \
		echo ''; \
		echo '#endif'; \
	} > "$(GENERATED_HEADER)"

$(MANAGED_ASSETS_HEADER): $(MANAGED_ASSETS) scripts/generate_managed_assets.py | $(BUILD_DIR)
	python3 scripts/generate_managed_assets.py managed "$@"

$(BINARY): $(SOURCES) $(GENERATED_HEADER) $(MANAGED_ASSETS_HEADER)
	$(CC) $(CPPFLAGS) -include "$(GENERATED_HEADER)" -include "$(MANAGED_ASSETS_HEADER)" $(CFLAGS) -o "$@" $(SOURCES) $(LDFLAGS)

$(UPDATE_HELPER): $(UPDATE_HELPER_SOURCE)
	$(CC) $(CPPFLAGS) $(CFLAGS) -o "$@" $(UPDATE_HELPER_SOURCE) $(LDFLAGS)

arm-release: $(GENERATED_HEADER) $(MANAGED_ASSETS_HEADER)
	arm-linux-gnueabihf-gcc $(CPPFLAGS) -include "$(GENERATED_HEADER)" -include "$(MANAGED_ASSETS_HEADER)" \
	  -Os -Wall -Wextra -Werror -std=c99 \
	  -march=armv7-a -mfpu=vfpv3-d16 -mfloat-abi=hard -fno-ident \
	  -frandom-seed=plaf203-state-agent \
	  -o "$(BINARY)" $(SOURCES) -static -Wl,--build-id=none
	arm-linux-gnueabihf-gcc $(CPPFLAGS) \
	  -Os -Wall -Wextra -Werror -std=c99 \
	  -march=armv7-a -mfpu=vfpv3-d16 -mfloat-abi=hard -fno-ident \
	  -frandom-seed=plaf203-update-fs \
	  -o "$(UPDATE_HELPER)" $(UPDATE_HELPER_SOURCE) -static -Wl,--build-id=none

clean:
	rm -f "$(BINARY)"
	rm -f "$(UPDATE_HELPER)"
	rm -rf "$(BUILD_DIR)"

.PHONY: all arm-release clean
