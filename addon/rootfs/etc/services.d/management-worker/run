#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

/usr/local/bin/petlibro-local-run management

socket_dir=/run/petlibro-management/worker
install -d -m 0700 -o root -g root "${socket_dir}"
rm -f -- "${socket_dir}/worker.sock"
umask 0077

bashio::log.info "Starting Petlibro Management native capability worker"
exec s6-envdir /run/petlibro-management/env \
    /usr/local/bin/node /opt/petlibro-management-worker/run.mjs
